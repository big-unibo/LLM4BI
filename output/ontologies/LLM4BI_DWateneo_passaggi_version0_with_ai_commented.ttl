    LLM4BI:SampleValues "modulo 1",
        "modulo 2" ;
    LLM4BI:isDescriptive true .

LLM4BI_Indyco:Sdoppiamento_Sdoppiamento a LLM4BI:ConformedAttribute ;
    LLM4BI:Description """nel modello logico funzionale riguarda l’attivita di massimo dettaglio, modulo, sdoppiamento o
frazionamento, che non viene ulteriormente suddiviso.
costituisce il livello piu basso in Plitvice e puo contenere componenti di qualsiasi genere (Attivita formativa monodisciplinare, Modulo Integrato, Modulo Generico, Frazionato, Sdoppiamento)""" ;
    LLM4BI:LogicalName "SDOPPIAMENTO" ;
    LLM4BI:RollUpArc LLM4BI_Indyco:Sdoppiamento_Anno_Corso,
        LLM4BI_Indyco:Sdoppiamento_Ciclo,
        LLM4BI_Indyco:Sdoppiamento_Codice_componente,
        LLM4BI_Indyco:Sdoppiamento_Codice_sdoppiamento,
        LLM4BI_Indyco:Sdoppiamento_Codice_sede_lezioni,
        LLM4BI_Indyco:Sdoppiamento_Disciplina,
        LLM4BI_Indyco:Sdoppiamento_Elearning,
        LLM4BI_Indyco:Sdoppiamento_Flag_guide,
        LLM4BI_Indyco:Sdoppiamento_Modulo__desc,
        LLM4BI_Indyco:Sdoppiamento_Tipo_Modulo,
        LLM4BI_Indyco:Sdoppiamento_Tipo_sdoppiamento ;
    LLM4BI:SampleValues "200537300",
        "200537333" ;
    LLM4BI:isOptional true .

LLM4BI_Indyco:Sdoppiamento_Specie_attivita a LLM4BI:ConformedAttribute ;
    LLM4BI:Description """definisce il tipo di Attivita Formativa. Le Specie Attivita (identificate dal campo
DIDATTICA.DI_ATTIVITAFORMATIVA.SPECIEATTIVITA) possono essere:
o A = altro
o B = Laboratorio
o D = debito formativo
o E = seminario
o F = prova finale
o I = insegnamento
o P = prova d’idoneita
o S = stage
o T = tirocinio
o V = attivita integrativa""" ;
    LLM4BI:LogicalName "DWPD_L_ATT_SPECIEATT" ;
    LLM4BI:SampleValues "attivita integrata",
        "integnamento",
        "laboratoriio",
        "ofa",
        "prova finale",
        "tirocinio" .


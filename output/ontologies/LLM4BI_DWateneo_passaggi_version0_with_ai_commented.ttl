LLM4BI_Indyco:Sdoppiamento_Disciplina a LLM4BI:Attribute,
        LLM4BI:ConformedAttribute ;
    LLM4BI:Description """corrisponde al Modulo Integrato, figlio delle attivita formative integrate, quando il
flag integrato e vero; in questo caso la disciplina avra una materia differente da quella
dell’Attivita Formativa padre che e indicata da Materia Disciplina2. Qualora l’attivita sia
monodisciplinare il flag integrato e valorizzato a falso e la disciplina risulta del tutto identica
alla radice. 
codice della disciplina integrata.""" ;
    LLM4BI:LogicalName "DWPD_L_ATT_DISCIPLINA" ;
    LLM4BI:RollUpArc LLM4BI_Indyco:SSD_SSD,
        LLM4BI_Indyco:Sdoppiamento_Ambito_PD,
        LLM4BI_Indyco:Sdoppiamento_Disciplina__desc,
        LLM4BI_Indyco:Sdoppiamento_Flag_Disc_Internazionale,
        LLM4BI_Indyco:Sdoppiamento_Flag_Disc_obbligatoria,
        LLM4BI_Indyco:Sdoppiamento_Materia,
        LLM4BI_Indyco:Sdoppiamento_Tipo_Disciplina,
        LLM4BI_Indyco:Sdoppiamento_Tipologia_Attivita_Formativa ;
    LLM4BI:isOptional true ;
    LLM4BI_Indyco:Sdoppiamento_lingua_disciplina_Lingua LLM4BI_Indyco:Lingua_Lingua .


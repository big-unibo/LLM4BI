LLM4BI_Indyco:Sdoppiamento_Materia a LLM4BI:ConformedAttribute ;
    LLM4BI:Description "Codice che individua la materia nell'orientamento nell’indirizzo nell'Ordinamento del Corso di Studio" ;
    LLM4BI:LogicalName "MATERIA" ;
    LLM4BI:RollUpArc LLM4BI_Indyco:Sdoppiamento_Denominazione_Materia,
        LLM4BI_Indyco:Sdoppiamento_Flag_Attivo,
        LLM4BI_Indyco:Sdoppiamento_Flag_Integrato,
        LLM4BI_Indyco:Sdoppiamento_Flag_Materia_UniBO,
        LLM4BI_Indyco:Sdoppiamento_Orientamento,
        LLM4BI_Indyco:Sdoppiamento_Specie_attivita,
        LLM4BI_Indyco:Sdoppiamento_Tipo_Attivita_Formativa ;
    LLM4BI:SampleValues "0002C",

        LLM4BI_Indyco:Ordinamento_CdS_Scuola,
        LLM4BI_Indyco:Ordinamento_CdS_Tipo_Ciclo,
        LLM4BI_Indyco:Ordinamento_CdS_Tipo_Corso ;
    LLM4BI:SampleValues "1256",
        "390" ;
    LLM4BI_Indyco:Ordinamento_CdS_Corso_di_Studio_Ordinamento_CdS_Facolta LLM4BI_Indyco:Ordinamento_CdS_Facolta ;
    LLM4BI_Indyco:Ordinamento_CdS_Sede_didattica_Sede LLM4BI_Indyco:Sede_Sede ;

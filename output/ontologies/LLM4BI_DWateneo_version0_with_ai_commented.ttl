LLM4BI_Indyco:DOT__Membri_del_Collegio_Docenti_Membri_del_collegio a LLM4BI:Attribute,
        LLM4BI:ConformedAttribute ;
    LLM4BI:Description "anagrafica dei docenti nel caso di non strutturati o strutturati di altri atenei; valorizzato per tutti i docenti che non risultano nella dim. Conforme \"docente nell'anno\"" ;
    LLM4BI:LogicalName "MEMBRI_DEL_COLLEGIO" ;
    LLM4BI:RollUpArc LLM4BI_Indyco:DOT__Membri_del_Collegio_Docenti_Cognome,
        LLM4BI_Indyco:DOT__Membri_del_Collegio_Docenti_Flag_strutturato,
        LLM4BI_Indyco:DOT__Membri_del_Collegio_Docenti_Nome,
        LLM4BI_Indyco:DOT__Membri_del_Collegio_Docenti_Qualifica_Collegio,
        LLM4BI_Indyco:DOT__Membri_del_Collegio_Docenti_Ruolo_Docente_nel_Collegio ;
    LLM4BI:SampleValues "A.A.||CF se c'e oppure derivato" ;
    LLM4BI_Indyco:DOT__Membri_del_Collegio_Docenti_Membri_del_collegio_Membri_del_collegio_Curriculum LLM4BI_Indyco:DOT__Membri_del_Collegio_Docenti_Curriculum ;
    LLM4BI_Indyco:DOT__Membri_del_Collegio_Docenti_Membri_del_collegio_Membri_del_collegio_Ente LLM4BI_Indyco:Ente_Ente .

LLM4BI_Indyco:DOT__Membri_del_Collegio_Docenti_Nome a LLM4BI:Attribute ;
    LLM4BI:Description "nome del docente non UNIBO" ;
    LLM4BI:LogicalName "NOME" ;
    LLM4BI:isDescriptive true .

LLM4BI_Indyco:DOT__Membri_del_Collegio_Docenti_Numero_Pubblicazioni a LLM4BI:Measure ;
    LLM4BI:Description "numero di pubblicazioni totale dei docenti del collegio" .

LLM4BI_Indyco:DOT__Membri_del_Collegio_Docenti_Qualifica_Collegio a LLM4BI:Attribute ;
    LLM4BI:Description "qualifica di ciascun membro del collegio; valorizzato per entrambe le tipologie di docenti" ;
    LLM4BI:LogicalName "QUALIFICA_COLLEGIO" ;
    LLM4BI:SampleValues """Primi ricercatori
Ricercatori
Ricercatore confermato
Dirigenti di ricerca
Professore di Univ.Straniera
Esperti di cui all’art. 6""",
        """c.4
Professore Associato confermato
Professore Ordinario
Professore Associato (L. 240/10)
Ricercatore a t.d. (art. 24 c.3-b L. 240/10)""" .


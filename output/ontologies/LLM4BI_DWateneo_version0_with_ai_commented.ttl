    LLM4BI:RollUpArc LLM4BI_Indyco:Ordinamento_CdS_Ambito,
        LLM4BI_Indyco:Ordinamento_CdS_AntePost,
        LLM4BI_Indyco:Ordinamento_CdS_CdS__desc,
        LLM4BI_Indyco:Ordinamento_CdS_Commissione_paritetica,
        LLM4BI_Indyco:Ordinamento_CdS_Filiera,
